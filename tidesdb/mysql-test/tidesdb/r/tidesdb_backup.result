CALL mtr.add_suppression("\\[TIDESDB\\] Backup to .* failed");
#
# ============================================
# TEST 1: Online backup creates a valid copy
# ============================================
#
CREATE TABLE t_backup (
id INT PRIMARY KEY,
val VARCHAR(100)
) ENGINE=TIDESDB;
INSERT INTO t_backup VALUES (1, 'alpha'), (2, 'beta'), (3, 'gamma');
SELECT * FROM t_backup ORDER BY id;
id	val
1	alpha
2	beta
3	gamma
# Triggering online backup
# Backup should have created the directory
Backup directory exists: YES
# Check that SHOW VARIABLES reflects the backup path
SELECT @@GLOBAL.tidesdb_backup_dir IS NOT NULL AS backup_dir_set;
backup_dir_set
1
# Insert more data after backup (should NOT appear in backup)
INSERT INTO t_backup VALUES (4, 'delta'), (5, 'epsilon');
SELECT COUNT(*) AS rows_after FROM t_backup;
rows_after
5
DROP TABLE t_backup;
#
# ============================================
# TEST 2: Backup into an existing directory succeeds
# ============================================
#
# TidesDB 10 writes a fresh consistent snapshot into the directory, so
# re-running a backup into a directory that already holds one succeeds.
SET GLOBAL tidesdb_backup_dir = 'MYSQLTEST_VARDIR/tmp/tidesdb_backup_test';
SELECT @@GLOBAL.tidesdb_backup_dir IS NOT NULL AS backup_dir_set;
backup_dir_set
1
#
# ============================================
# TEST 3: Clear backup_dir variable
# ============================================
#
SET GLOBAL tidesdb_backup_dir = '';
SELECT @@GLOBAL.tidesdb_backup_dir IS NULL AS backup_dir_cleared;
backup_dir_cleared
1
#
# ============================================
# TEST 4: Concurrent reads/writes during backup
# ============================================
#
CREATE TABLE t_concurrent (
id INT PRIMARY KEY,
data VARCHAR(200)
) ENGINE=TIDESDB;
# Inserted 100 rows
SELECT COUNT(*) AS before_backup FROM t_concurrent;
before_backup
100
# Backup completed while table was loaded
SELECT COUNT(*) AS after_backup FROM t_concurrent;
after_backup
100
INSERT INTO t_concurrent VALUES (101, 'post-backup');
SELECT COUNT(*) AS with_post_backup FROM t_concurrent;
with_post_backup
101
DROP TABLE t_concurrent;
#
# ============================================
# TEST 5: There is no per-table physical copy
# ============================================
#
# FLUSH TABLES ... FOR EXPORT asks the engine to leave a set of files on
# disk that can be copied out and read back as one table.  The store is one
# flat directory with a database-wide manifest and value log, an sstable
# holds whichever families flushed together, and the newest rows are in a
# memtable shared by every table -- no subset of that is one table.  The
# engine does not claim the capability, so the server refuses the statement
# rather than accepting it and leaving an incomplete copy behind.
CREATE TABLE t_export (id INT PRIMARY KEY, val VARCHAR(50)) ENGINE=TIDESDB;
INSERT INTO t_export VALUES (1, 'a'), (2, 'b');
FLUSH TABLES t_export FOR EXPORT;
ERROR HY000: Table storage engine for 't_export' doesn't have this option
# and the table is untouched by the refusal
SELECT id, val FROM t_export ORDER BY id;
id	val
1	a
2	b
DROP TABLE t_export;
#
# === Cleanup ===
#
SET GLOBAL tidesdb_backup_dir = '';
# Done.
