#
# Setup
#
CREATE TABLE places (
id   INT NOT NULL PRIMARY KEY,
name VARCHAR(100),
loc  GEOMETRY NOT NULL SRID 0,
SPATIAL INDEX (loc)
) ENGINE=TidesDB;
INSERT INTO places VALUES (1, 'NYC',     ST_GeomFromText('POINT(40.7128 -74.0060)', 0));
INSERT INTO places VALUES (2, 'LA',      ST_GeomFromText('POINT(34.0522 -118.2437)', 0));
INSERT INTO places VALUES (3, 'Chicago', ST_GeomFromText('POINT(41.8781 -87.6298)', 0));
INSERT INTO places VALUES (4, 'Houston', ST_GeomFromText('POINT(29.7604 -95.3698)', 0));
INSERT INTO places VALUES (5, 'Phoenix', ST_GeomFromText('POINT(33.4484 -112.074)', 0));
#
# TEST 0: the optimizer reaches the spatial index rather than scanning
#
EXPLAIN SELECT name FROM places
WHERE MBRIntersects(loc,
ST_GeomFromText('POLYGON((39 -76, 43 -76, 43 -72, 39 -72, 39 -76))', 0));
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	places	NULL	range	loc	loc	34	NULL	ROWS	100.00	Using where
Warnings:
Note	1003	/* select#1 */ select `test`.`places`.`name` AS `name` from `test`.`places` where mbrintersects(`test`.`places`.`loc`,<cache>(st_geomfromtext('POLYGON((39 -76, 43 -76, 43 -72, 39 -72, 39 -76))',0)))
#
# TEST 1: MBRIntersects - find cities near northeast US
#
SELECT name FROM places
WHERE MBRIntersects(loc,
ST_GeomFromText('POLYGON((39 -76, 43 -76, 43 -72, 39 -72, 39 -76))', 0))
ORDER BY name;
name
NYC
#
# TEST 2: MBRContains - all cities within big US box
#
SELECT name FROM places
WHERE MBRContains(
ST_GeomFromText('POLYGON((25 -125, 45 -125, 45 -70, 25 -70, 25 -125))', 0),
loc)
ORDER BY name;
name
Chicago
Houston
LA
NYC
Phoenix
#
# TEST 3: MBRWithin - same as above using MBRWithin
#
SELECT name FROM places
WHERE MBRWithin(loc,
ST_GeomFromText('POLYGON((25 -125, 45 -125, 45 -70, 25 -70, 25 -125))', 0))
ORDER BY name;
name
Chicago
Houston
LA
NYC
Phoenix
#
# TEST 4: UPDATE geometry and verify search
#
UPDATE places SET loc = ST_GeomFromText('POINT(40.0 -74.5)', 0) WHERE id = 1;
SELECT name FROM places
WHERE MBRIntersects(loc,
ST_GeomFromText('POLYGON((39 -76, 43 -76, 43 -72, 39 -72, 39 -76))', 0))
ORDER BY name;
name
NYC
#
# TEST 5: DELETE and verify search
#
DELETE FROM places WHERE id = 1;
SELECT name FROM places
WHERE MBRIntersects(loc,
ST_GeomFromText('POLYGON((39 -76, 43 -76, 43 -72, 39 -72, 39 -76))', 0))
ORDER BY name;
name
#
# TEST 6: Simple point-in-box
#
DROP TABLE places;
CREATE TABLE pts (id INT PRIMARY KEY, g GEOMETRY NOT NULL SRID 0, SPATIAL INDEX(g)) ENGINE=TidesDB;
INSERT INTO pts VALUES (1, ST_GeomFromText('POINT(10 20)', 0));
INSERT INTO pts VALUES (2, ST_GeomFromText('POINT(30 40)', 0));
INSERT INTO pts VALUES (3, ST_GeomFromText('POINT(50 60)', 0));
EXPLAIN SELECT id FROM pts
WHERE MBRWithin(g, ST_GeomFromText('POLYGON((5 15, 35 15, 35 45, 5 45, 5 15))', 0));
id	select_type	table	partitions	type	possible_keys	key	key_len	ref	rows	filtered	Extra
1	SIMPLE	pts	NULL	range	g	g	34	NULL	ROWS	100.00	Using where
Warnings:
Note	1003	/* select#1 */ select `test`.`pts`.`id` AS `id` from `test`.`pts` where mbrwithin(`test`.`pts`.`g`,<cache>(st_geomfromtext('POLYGON((5 15, 35 15, 35 45, 5 45, 5 15))',0)))
SELECT id FROM pts
WHERE MBRWithin(g, ST_GeomFromText('POLYGON((5 15, 35 15, 35 45, 5 45, 5 15))', 0))
ORDER BY id;
id
1
2
#
# Cleanup
#
DROP TABLE pts;
# Done.
